				float3 rotatedValue264 = RotateAroundAxis( ( ( PivotRandom217 * _TurbulenceRadius * float3( -1, 0, 0 ) ) + PovitPosition76 ), PovitPosition76, float3( 0, 1, 0 ), sin( ( ( ( EffectMask104 * EffectMask104 ) * _TurbulenceFreq ) + PivotRandom217 ) ) );
				float3 Turbulence345 = ( rotatedValue264 * ( EffectMask104 * EffectMask104 ) );
				float dotResult4_g25 = dot( (PovitPosition76).xz , float2( 12.9898,78.233 ) );
				float lerpResult10_g25 = lerp( -1.0 , 1.0 , frac( ( sin( dotResult4_g25 ) * 43758.55 ) ));
