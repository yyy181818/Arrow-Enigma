				float EffectMask104 = ( 1.0 - clampResult253 );
				float temp_output_308_0 = ( EffectMask104 * EffectMask104 );
				float PivotRandom217 = 0.0;
				float temp_output_147_0 = ( _Rotate * temp_output_308_0 * PivotRandom217 );
				float3 lerpResult341 = lerp( input.positionOS.xyz , PovitPosition76 , EffectMask104);
